<% cfg = @badge_config || BadgeConfig.defaults %>
<% acc = cfg.event_name_color; hdr = cfg.header_footer_color %>
<% chip_label = @is_coordinator ? "Coordenador" : (@function_name.presence || "Colaborador") %>
<% chip_bg = @is_coordinator ? '#15803d' : '#18181b' %>

<div class="badge">

  <%# Barra accent topo %>
  <div class="badge-top-bar" style="background:<%= @is_coordinator ? acc : '#27272a' %>;"></div>

  <%# Header %>
  <div class="badge-header">
    <span class="badge-brand"><%= @event&.company&.name || "Backstage" %></span>
    <% if @event %>
      <div class="badge-event-info">
        <div class="badge-event-name"><%= @event.name %></div>
        <div class="badge-event-date">
          <%= l(@event.start_date, format: :short) %> a <%= l(@event.end_date, format: :short) %>
          <% if @event.location.present? %> &middot; <%= @event.location %><% end %>
        </div>
      </div>
    <% end %>
    <div class="badge-clearfix"></div>
  </div>

  <%# Body %>
  <div class="badge-body">
    <div class="badge-photo">
      <% if @avatar_base64 %>
        <img src="<%= @avatar_base64 %>">
      <% else %>
        <span class="badge-photo-initials"><%= @user.name.split.map(&:first).first(2).join.upcase %></span>
      <% end %>
    </div>
    <div class="badge-name"><%= @user.name %></div>
    <div class="badge-role-chip" style="background:<%= chip_bg %>;"><%= chip_label %></div>
    <% if @team %>
      <div class="badge-team-info"><strong><%= @team.sector.name %></strong> &middot; <%= @team.name %></div>
    <% end %>
    <div class="badge-cpf"><%= @user.formatted_cpf %></div>
    <div class="badge-divider"></div>
  </div>

  <%# Footer fixo no fundo %>
  <div class="badge-footer">
    <div class="badge-footer-qr">
      <%= badge_qr_svg(@credential_qr_code.presence || "BST#{@user.id}", pixel_size: 44, color: acc, bg: hdr) %>
    </div>
    <div class="badge-meta">
      <% if @credential_code.present? %>
        <span class="badge-meta-label">Credencial</span>
        <span class="badge-credential-code"><%= @credential_code %></span>
      <% end %>
      <span class="badge-meta-label" style="margin-top:3px;">Acesso</span>
      <span class="badge-meta-value">Todos os dias</span>
    </div>
    <div class="badge-clearfix"></div>
  </div>

</div>

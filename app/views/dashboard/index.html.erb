<%
  hour     = Time.current.hour
  greeting = hour < 12 ? "Bom dia" : hour < 18 ? "Boa tarde" : "Boa noite"
  company_without_plan = !current_user.admin? && current_event&.company && current_event.company.plan.nil?
%>

<% if company_without_plan %>
  <div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;padding:1rem 1.25rem;margin-bottom:1.5rem;display:flex;align-items:flex-start;gap:0.85rem;">
    <i class="bi bi-exclamation-circle-fill" style="color:#dc2626;font-size:1.3rem;flex-shrink:0;margin-top:1px;"></i>
    <div>
      <div style="font-size:0.9rem;font-weight:700;color:#991b1b;margin-bottom:0.2rem;">Empresa sem plano ativo</div>
      <div style="font-size:0.82rem;color:#b91c1c;line-height:1.5;">
        A empresa <strong><%= current_event.company.name %></strong> não possui um plano vinculado.
        As funcionalidades do sistema estão bloqueadas até que um plano seja contratado.
      </div>
    </div>
  </div>
<% end %>

<%# ── Header ──────────────────────────────────────────────────────────────── %>
<div class="page-header" style="margin-bottom:1.5rem;">
  <div>
    <h1 style="margin:0;"><%= greeting %>, <%= current_user.name.split.first %> 👋</h1>
    <div style="font-size:0.82rem;color:#71717a;margin-top:0.2rem;">
      <%= l(Date.today, format: :long) %>
    </div>
  </div>
  <% if policy(Event).new? %>
    <%= link_to new_event_path, class: "btn-primary" do %>
      <i class="bi bi-plus"></i> Novo evento
    <% end %>
  <% end %>
</div>

<%# ── Tab bar ─────────────────────────────────────────────────────────────── %>
<div id="dash-tab-bar" style="display:flex;gap:4px;margin-bottom:1.5rem;border-bottom:1px solid #e4e4e7;">
  <button id="tab-btn-visao-geral"
          onclick="switchTab('visao-geral')"
          style="display:flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;border:1px solid #e4e4e7;border-bottom:1px solid #ffffff;border-radius:6px 6px 0 0;background:#ffffff;cursor:pointer;font-size:0.85rem;font-weight:600;color:#18181b;margin-bottom:-1px;box-shadow:inset 0 2px 0 #18181b;position:relative;z-index:1;transition:all 0.15s;">
    <i class="bi bi-grid-1x2" style="font-size:0.85rem;"></i> Visão Geral
  </button>
  <button id="tab-btn-calendario"
          onclick="switchTab('calendario')"
          style="display:flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;border:1px solid transparent;border-bottom:none;border-radius:6px 6px 0 0;background:transparent;cursor:pointer;font-size:0.85rem;font-weight:400;color:#71717a;margin-bottom:-1px;transition:all 0.15s;">
    <i class="bi bi-calendar3" style="font-size:0.85rem;"></i> Calendário
  </button>
  <button id="tab-btn-financeiro"
          onclick="switchTab('financeiro')"
          style="display:flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;border:1px solid transparent;border-bottom:none;border-radius:6px 6px 0 0;background:transparent;cursor:pointer;font-size:0.85rem;font-weight:400;color:#71717a;margin-bottom:-1px;transition:all 0.15s;">
    <i class="bi bi-cash-stack" style="font-size:0.85rem;"></i> Financeiro
  </button>
  <button id="tab-btn-colaboradores"
          onclick="switchTab('colaboradores')"
          style="display:flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;border:1px solid transparent;border-bottom:none;border-radius:6px 6px 0 0;background:transparent;cursor:pointer;font-size:0.85rem;font-weight:400;color:#71717a;margin-bottom:-1px;transition:all 0.15s;">
    <i class="bi bi-people" style="font-size:0.85rem;"></i> Colaboradores
  </button>
</div>

<%# ══════════════════════════════════════════════════════════════════════════
    PAINEL 1 — VISÃO GERAL
══════════════════════════════════════════════════════════════════════════ %>
<div id="tab-visao-geral">

  <%# ── 4 métricas ──────────────────────────────────────────────────────────── %>
  <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0.75rem;margin-bottom:1rem;">
    <div class="metric-card" style="border-top:3px solid #18181b;">
      <div class="metric-label"><i class="bi bi-calendar-event"></i> Total de eventos</div>
      <div class="metric-value"><%= @total_events %></div>
      <div class="metric-sub"><%= @active_events %> ativo<%= @active_events != 1 ? "s" : "" %> · <%= @closed_events_count %> encerrado<%= @closed_events_count != 1 ? "s" : "" %></div>
    </div>
    <div class="metric-card" style="border-top:3px solid #4ade80;">
      <div class="metric-label"><i class="bi bi-people"></i> Colaboradores</div>
      <div class="metric-value metric-accent"><%= @total_users %></div>
      <div class="metric-sub">cadastrados</div>
    </div>
    <div class="metric-card" style="border-top:3px solid #3b82f6;">
      <div class="metric-label"><i class="bi bi-building"></i> Setores</div>
      <div class="metric-value" style="color:#3b82f6;"><%= @total_sectors %></div>
      <div class="metric-sub">em todos os eventos</div>
    </div>
    <div class="metric-card" style="border-top:3px solid #8b5cf6;">
      <div class="metric-label"><i class="bi bi-graph-up-arrow"></i> Taxa de presença</div>
      <div class="metric-value" style="color:#8b5cf6;"><%= @historical_attendance_rate %>%</div>
      <div class="metric-sub">média histórica</div>
    </div>
  </div>

  <%# ── Evento em destaque + Checklist/Alertas ──────────────────────────────── %>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">

    <%# Evento em destaque %>
    <div class="content-card" style="padding:1.1rem;">
      <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:0.85rem;">
        <i class="bi bi-star"></i> Evento atual em destaque
      </div>
      <% if @featured_event %>
        <div style="font-size:0.95rem;font-weight:700;color:#18181b;margin-bottom:3px;"><%= @featured_event.name %></div>
        <div style="font-size:0.75rem;color:#71717a;margin-bottom:0.85rem;display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center;">
          <% if @featured_event.location.present? %>
            <span><i class="bi bi-geo-alt"></i> <%= @featured_event.location %></span>
          <% end %>
          <span><i class="bi bi-calendar"></i> <%= l(@featured_event.start_date, format: :short) %></span>
          <span class="badge-status badge-<%= @featured_event.status %>"><%= t("event_statuses.#{@featured_event.status}") %></span>
        </div>
        <%
          feat_rows = [
            ["Setores",              @feat_sectors,                                        nil],
            ["Equipes",              @feat_teams,                                          nil],
            ["Membros escalados",    @feat_members,                                        nil],
            ["Substituições ativas", @feat_substitutes,  @feat_substitutes > 0 ? "#7c3aed" : nil],
            ["Check-ins hoje",       "#{@feat_checkins_today} / #{@feat_members}", @feat_checkins_today > 0 ? "#16a34a" : nil],
          ]
        %>
        <% feat_rows.each do |label, val, color| %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid #f4f4f5;font-size:0.82rem;">
            <span style="color:#71717a;"><%= label %></span>
            <span style="font-weight:600;<%= color ? "color:#{color};" : "" %>"><%= val %></span>
          </div>
        <% end %>
        <div style="height:5px;border-radius:99px;background:#f4f4f5;overflow:hidden;margin-top:0.85rem;">
          <div style="height:100%;width:<%= @feat_presence_pct %>%;background:#4ade80;border-radius:99px;transition:width 0.4s;"></div>
        </div>
        <div style="font-size:0.68rem;color:#a1a1aa;margin-top:4px;"><%= @feat_presence_pct %>% de presença hoje</div>
      <% else %>
        <div style="text-align:center;color:#a1a1aa;font-size:0.82rem;padding:2rem 0;">
          Nenhum evento selecionado.
        </div>
      <% end %>
    </div>

    <div style="display:flex;flex-direction:column;gap:1rem;">

      <%# Checklist de prontidão do evento %>
      <% if @featured_event %>
        <div class="content-card" style="padding:1.1rem;">
          <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:0.75rem;">
            <i class="bi bi-check2-square"></i> Prontidão do evento
          </div>
          <%
            cred_status = if @feat_members > 0 && @feat_credentials == @feat_members then :ok
                          elsif @feat_credentials.to_i > 0 then :warn
                          else :bad
                          end
            checklist_items = [
              { label: "Setores cadastrados", status: @feat_sectors > 0 ? :ok : :bad,
                sub: "#{@feat_sectors} setor#{"es" if @feat_sectors != 1}" },
              { label: "Equipes formadas",    status: @feat_teams > 0 ? :ok : :bad,
                sub: "#{@feat_teams} equipe#{"s" if @feat_teams != 1}" },
              { label: "Escalas definidas",   status: @feat_has_shifts ? :ok : :bad,
                sub: @feat_has_shifts ? "definidas" : "nenhuma" },
              { label: "Credenciais geradas", status: cred_status,
                sub: "#{@feat_credentials} / #{@feat_members}" },
            ]
          %>
          <% checklist_items.each do |item| %>
            <%
              icon_color, bg_color, border_color, icon_class = case item[:status]
              when :ok   then ["#16a34a", "#f0fdf4", "#86efac", "bi-check"]
              when :warn then ["#d97706", "#fffbeb", "#fde68a", "bi-dash"]
              else            ["#dc2626", "#fef2f2", "#fca5a5", "bi-x"]
              end
            %>
            <div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #f4f4f5;font-size:0.82rem;">
              <div style="width:20px;height:20px;border-radius:50%;background:<%= bg_color %>;border:1px solid <%= border_color %>;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi <%= icon_class %>" style="font-size:0.7rem;color:<%= icon_color %>;"></i>
              </div>
              <span style="flex:1;color:#18181b;"><%= item[:label] %></span>
              <span style="font-size:0.72rem;color:<%= icon_color %>;font-weight:600;"><%= item[:sub] %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Alertas %>
      <div class="content-card" style="padding:1.1rem;flex:1;">
        <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:0.75rem;">
          <i class="bi bi-exclamation-triangle"></i> Atenção
        </div>
        <% has_alerts = @events_without_teams.any? || @events_without_shifts.any? || @missing_checkouts_count > 0 %>
        <% if has_alerts %>
          <% @events_without_teams.each do |ev| %>
            <div style="display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;background:#fef2f2;border:1px solid #fca5a5;margin-bottom:5px;font-size:0.78rem;color:#991b1b;">
              <i class="bi bi-x-circle" style="font-size:0.85rem;flex-shrink:0;"></i>
              <span><strong><%= ev.name %></strong> — sem equipes</span>
            </div>
          <% end %>
          <% @events_without_shifts.each do |ev| %>
            <div style="display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;background:#fffbeb;border:1px solid #fde68a;margin-bottom:5px;font-size:0.78rem;color:#92400e;">
              <i class="bi bi-exclamation-triangle" style="font-size:0.85rem;flex-shrink:0;"></i>
              <span><strong><%= ev.name %></strong> — sem escalas</span>
            </div>
          <% end %>
          <% if @missing_checkouts_count > 0 %>
            <div style="display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;background:#eff6ff;border:1px solid #bfdbfe;font-size:0.78rem;color:#1e40af;">
              <i class="bi bi-clock" style="font-size:0.85rem;flex-shrink:0;"></i>
              <span><strong><%= @missing_checkouts_count %></strong> sem check-out ontem</span>
            </div>
          <% end %>
        <% else %>
          <div style="text-align:center;color:#a1a1aa;font-size:0.78rem;padding:1rem 0;">
            <i class="bi bi-check-circle" style="display:block;font-size:1.2rem;margin-bottom:4px;color:#4ade80;"></i>
            Nenhuma pendência
          </div>
        <% end %>
      </div>

    </div>
  </div>

  <%# ── Próximos eventos ────────────────────────────────────────────────────── %>
  <% if @upcoming_events_data.any? %>
    <div class="content-card" style="padding:1.1rem;">
      <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:0.85rem;">
        <i class="bi bi-calendar-check"></i> Próximos eventos
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem;">
        <% @upcoming_events_data.each do |d| %>
          <% ev = d[:event]; days_away = (ev.start_date - Date.today).to_i %>
          <%= link_to event_path(ev), style: "text-decoration:none;" do %>
            <div style="display:flex;align-items:center;gap:0.75rem;padding:0.55rem 0.75rem;border-radius:8px;border:1px solid #f4f4f5;transition:border-color 0.15s;"
                 onmouseover="this.style.borderColor='#d4d4d8'" onmouseout="this.style.borderColor='#f4f4f5'">
              <div style="width:38px;text-align:center;flex-shrink:0;">
                <div style="font-size:1rem;font-weight:800;color:#18181b;line-height:1;"><%= ev.start_date.day %></div>
                <div style="font-size:0.6rem;color:#71717a;text-transform:uppercase;"><%= I18n.l(ev.start_date, format: "%b") %></div>
              </div>
              <div style="width:1px;height:28px;background:#e4e4e7;flex-shrink:0;"></div>
              <div style="flex:1;min-width:0;">
                <div style="font-size:0.82rem;font-weight:600;color:#18181b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= ev.name %></div>
                <% if !d[:has_teams] %>
                  <div style="font-size:0.68rem;color:#d97706;margin-top:1px;"><i class="bi bi-exclamation-triangle"></i> sem equipes cadastradas</div>
                <% elsif !d[:has_shifts] %>
                  <div style="font-size:0.68rem;color:#d97706;margin-top:1px;"><i class="bi bi-exclamation-triangle"></i> sem escalas definidas</div>
                <% else %>
                  <div style="font-size:0.68rem;color:#71717a;margin-top:1px;">
                    <%= d[:members] %> membro<%= d[:members] != 1 ? "s" : "" %> · <%= d[:sectors] %> setor<%= d[:sectors] != 1 ? "es" : "" %><% if ev.location.present? %> · <i class="bi bi-geo-alt"></i> <%= ev.location %><% end %>
                  </div>
                <% end %>
              </div>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0;">
                <span class="badge-status badge-<%= ev.status %>"><%= t("event_statuses.#{ev.status}") %></span>
                <span style="font-size:0.62rem;color:#a1a1aa;">
                  <%= days_away == 0 ? "hoje" : "em #{days_away} dia#{"s" if days_away > 1}" %>
                </span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

</div><%# /tab-visao-geral %>

<%# ══════════════════════════════════════════════════════════════════════════
    PAINEL 2 — FINANCEIRO
══════════════════════════════════════════════════════════════════════════ %>
<div id="tab-financeiro" style="display:none;">

  <div style="display:flex;align-items:center;gap:0.5rem;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:0.55rem 0.9rem;margin-bottom:0.75rem;font-size:0.78rem;color:#15803d;">
    <i class="bi bi-info-circle-fill" style="font-size:0.85rem;flex-shrink:0;"></i>
    Os valores exibidos consideram apenas <strong>eventos encerrados</strong>. Eventos em andamento ou planejamento não são computados.
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.75rem;">
    <div class="metric-card" style="border-top:3px solid #16a34a;">
      <div class="metric-label"><i class="bi bi-cash-stack"></i> Custo médio</div>
      <div class="metric-value" style="font-size:1.1rem;color:#15803d;">
        <%= number_to_currency(@total_events > 0 ? @total_cost / @total_events : 0, unit:"R$", separator:",", delimiter:".", precision:0) %>
      </div>
      <div class="metric-sub">por evento</div>
    </div>
    <div class="metric-card" style="border-top:3px solid #15803d;">
      <div class="metric-label"><i class="bi bi-currency-dollar"></i> Custo total</div>
      <div class="metric-value" style="font-size:1.1rem;color:#15803d;">
        <%= number_to_currency(@total_cost, unit:"R$", separator:",", delimiter:".", precision:0) %>
      </div>
      <div class="metric-sub">acumulado</div>
    </div>
  </div>

  <%# Evolução mensal de custo — últimos 12 meses %>
  <% if @cost_by_month.any? %>
    <%
      month_names = { "01"=>"Jan","02"=>"Fev","03"=>"Mar","04"=>"Abr","05"=>"Mai","06"=>"Jun",
                      "07"=>"Jul","08"=>"Ago","09"=>"Set","10"=>"Out","11"=>"Nov","12"=>"Dez" }
      month_max   = @last_12_months.map { |m| @cost_by_month[m] }.max.to_f
    %>
    <div class="content-card" style="padding:1.1rem;margin-bottom:0.75rem;">
      <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:1rem;">
        <i class="bi bi-graph-up"></i> Evolução de custo — últimos 12 meses
      </div>
      <div style="overflow-x:auto;">
        <div style="display:flex;align-items:flex-end;gap:0.4rem;height:110px;min-width:<%= @last_12_months.size * 52 %>px;">
          <% @last_12_months.each do |ym| %>
            <% cost = @cost_by_month[ym].to_f %>
            <% pct  = month_max > 0 ? [(cost / month_max * 100).round, 100].min : 0 %>
            <% is_current = ym == Date.today.strftime("%Y-%m") %>
            <div style="flex:1;min-width:44px;display:flex;flex-direction:column;align-items:center;height:100%;">
              <div style="font-size:0.58rem;font-weight:700;color:<%= cost > 0 ? '#18181b' : '#d4d4d8' %>;margin-bottom:4px;white-space:nowrap;">
                <%= cost > 0 ? number_to_currency(cost, unit:"R$", separator:",", delimiter:".", precision:0) : "—" %>
              </div>
              <div style="flex:1;width:100%;display:flex;align-items:flex-end;">
                <div style="width:100%;height:<%= [pct, cost > 0 ? 4 : 2].max %>%;background:<%= is_current ? '#4ade80' : (cost > 0 ? '#6366f1' : '#f4f4f5') %>;border-radius:4px 4px 0 0;"></div>
              </div>
            </div>
          <% end %>
        </div>
        <div style="display:flex;gap:0.4rem;border-top:1px solid #e4e4e7;padding-top:0.4rem;min-width:<%= @last_12_months.size * 52 %>px;">
          <% @last_12_months.each do |ym| %>
            <% year, month = ym.split("-") %>
            <% is_current  = ym == Date.today.strftime("%Y-%m") %>
            <div style="flex:1;min-width:44px;text-align:center;font-size:0.6rem;color:<%= is_current ? '#18181b' : '#a1a1aa' %>;font-weight:<%= is_current ? 700 : 400 %>;">
              <%= month_names[month] %>
              <span style="display:block;font-size:0.52rem;"><%= year %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Gasto médio por função — barras horizontais %>
  <% if @avg_cost_by_function.any? %>
    <%
      fn_rows  = @avg_cost_by_function.first(12)
      fn_max   = fn_rows.map(&:last).max.to_f
    %>
    <div class="content-card" style="padding:1.1rem;margin-bottom:0.75rem;">
      <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:1rem;">
        <i class="bi bi-person-workspace"></i> Gasto médio por função por evento
      </div>
      <div style="display:flex;flex-direction:column;gap:0.45rem;">
        <% fn_rows.each do |fn_name, avg| %>
          <% pct = fn_max > 0 ? (avg / fn_max * 100).round(1) : 0 %>
          <div style="display:grid;grid-template-columns:160px 1fr 90px;align-items:center;gap:0.65rem;">
            <div style="font-size:0.73rem;color:#27272a;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
                 title="<%= fn_name %>">
              <%= fn_name %>
            </div>
            <div style="background:#f4f4f5;border-radius:4px;height:16px;overflow:hidden;">
              <div style="width:<%= pct %>%;height:100%;background:#6366f1;border-radius:4px;transition:width 0.3s;"></div>
            </div>
            <div style="font-size:0.78rem;font-weight:700;color:#4338ca;text-align:right;white-space:nowrap;">
              <%= number_to_currency(avg, unit:"R$", separator:",", delimiter:".", precision:0) %>
            </div>
          </div>
        <% end %>
      </div>
      <% if @avg_cost_by_function.size > 12 %>
        <div style="margin-top:0.5rem;font-size:0.65rem;color:#a1a1aa;text-align:right;">
          + <%= @avg_cost_by_function.size - 12 %> função(ões) não exibida(s)
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Gasto médio por tipo de evento %>
  <div class="content-card" style="padding:1.1rem;margin-bottom:0.75rem;">
    <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:1rem;">
      <i class="bi bi-bar-chart-line"></i> Gasto médio por tipo de evento
    </div>
    <% if @events_by_type.any? %>
      <%
        ev_sorted  = @events_by_type
                       .sort_by { |type, _| -(@cost_by_event_type[type] || 0) }
                       .first(10)
        ev_max_avg = ev_sorted.map { |type, count| count > 0 ? @cost_by_event_type[type].to_f / count : 0 }.max.to_f
        ev_rest    = @events_by_type.size - ev_sorted.size
      %>
      <div style="overflow-x:auto;">
        <div style="display:flex;align-items:flex-end;gap:0.5rem;height:110px;min-width:<%= [ev_sorted.size * 60, 200].max %>px;">
          <% ev_sorted.each do |type, count| %>
            <% avg = count > 0 ? @cost_by_event_type[type].to_f / count : 0 %>
            <% pct = ev_max_avg > 0 ? [(avg / ev_max_avg * 100).round, 100].min : 4 %>
            <div style="flex:1;min-width:52px;display:flex;flex-direction:column;align-items:center;height:100%;">
              <div style="font-size:0.6rem;font-weight:700;color:#18181b;margin-bottom:4px;white-space:nowrap;">
                <%= avg > 0 ? number_to_currency(avg, unit:"R$", separator:",", delimiter:".", precision:0) : "—" %>
              </div>
              <div style="flex:1;width:100%;display:flex;align-items:flex-end;">
                <div style="width:100%;height:<%= [pct, 4].max %>%;background:#6366f1;border-radius:4px 4px 0 0;opacity:<%= avg > 0 ? 1 : 0.2 %>;"></div>
              </div>
            </div>
          <% end %>
        </div>
        <div style="display:flex;gap:0.5rem;border-top:1px solid #e4e4e7;padding-top:0.45rem;min-width:<%= [ev_sorted.size * 60, 200].max %>px;">
          <% ev_sorted.each do |type, count| %>
            <div style="flex:1;min-width:52px;font-size:0.6rem;color:#71717a;text-align:center;line-height:1.3;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
              <%= I18n.t("event_types.#{type}", default: type.humanize) %>
              <span style="display:block;color:#a1a1aa;font-size:0.55rem;"><%= count %> ev.</span>
            </div>
          <% end %>
        </div>
      </div>
      <% if ev_rest > 0 %>
        <div style="margin-top:0.5rem;font-size:0.7rem;color:#a1a1aa;text-align:right;">
          + <%= ev_rest %> tipo<%= ev_rest > 1 ? "s" : "" %> não exibido<%= ev_rest > 1 ? "s" : "" %>
        </div>
      <% end %>
    <% else %>
      <div style="text-align:center;padding:1.5rem 0;color:#a1a1aa;font-size:0.82rem;">
        <i class="bi bi-tag" style="font-size:1.5rem;display:block;margin-bottom:0.5rem;opacity:0.4;"></i>
        Nenhum evento com tipo definido ainda.
      </div>
    <% end %>
  </div>

  <%# Gasto médio por tipo de setor %>
  <% if @sectors_by_type.any? %>
    <div class="content-card" style="padding:1.1rem;margin-bottom:0.75rem;">
      <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:1rem;">
        <i class="bi bi-bar-chart"></i> Gasto médio por tipo de setor
      </div>
      <%
        sorted_types = @sectors_by_type.sort_by { |type, _| -(@cost_by_sector_type[type] || 0) }
        max_avg      = sorted_types.map { |type, count| count > 0 ? @cost_by_sector_type[type].to_f / count : 0 }.max.to_f
      %>
      <div style="overflow-x:auto;">
        <div style="display:flex;align-items:flex-end;gap:0.75rem;height:110px;min-width:<%= sorted_types.size * 64 %>px;">
          <% sorted_types.each do |type, count| %>
            <% avg = count > 0 ? @cost_by_sector_type[type].to_f / count : 0 %>
            <% pct = max_avg > 0 ? [(avg / max_avg * 100).round, 100].min : 0 %>
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;height:100%;">
              <div style="font-size:0.62rem;font-weight:700;color:#18181b;margin-bottom:4px;white-space:nowrap;">
                <%= number_to_currency(avg, unit:"R$", separator:",", delimiter:".", precision:0) %>
              </div>
              <div style="flex:1;width:100%;display:flex;align-items:flex-end;">
                <div style="width:100%;height:<%= pct %>%;background:#18181b;border-radius:4px 4px 0 0;min-height:4px;"></div>
              </div>
            </div>
          <% end %>
        </div>
        <div style="display:flex;gap:0.75rem;border-top:1px solid #e4e4e7;padding-top:0.5rem;min-width:<%= sorted_types.size * 64 %>px;">
          <% sorted_types.each do |type, _| %>
            <div style="flex:1;font-size:0.65rem;color:#71717a;text-align:center;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              <%= I18n.t("sector_types.#{type}", default: type.humanize) %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Heatmap: Gasto por tipo de evento × tipo de setor %>
  <% if @cost_matrix.any? %>
    <%
      matrix_ev_types  = @cost_matrix.keys
                           .sort_by { |et| -@cost_matrix[et].values.sum }
                           .first(6)
      matrix_sec_types = @cost_matrix.values
                           .flat_map(&:keys).uniq
                           .sort_by { |st| -@cost_matrix.values.sum { |h| h[st].to_f } }
                           .first(6)
      matrix_avg_max   = matrix_ev_types.flat_map { |et|
        ev_count = @events_by_type[et].to_i
        matrix_sec_types.map { |st| ev_count > 0 ? @cost_matrix[et][st].to_f / ev_count : 0 }
      }.max.to_f
      matrix_total_max = matrix_ev_types.flat_map { |et|
        matrix_sec_types.map { |st| @cost_matrix[et][st].to_f }
      }.max.to_f
      hm_bg    = ->(i)    { i > 0 ? "rgba(99,102,241,#{(0.12 + i * 0.88).round(2)})" : "#f4f4f5" }
      hm_color = ->(i, v) { i > 0.5 ? "#fff" : (v ? "#27272a" : "#a1a1aa") }
    %>
    <div class="content-card" style="padding:1.1rem;margin-bottom:1.5rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
        <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">
          <i class="bi bi-grid-3x3-gap"></i> Mapa de Gastos — Evento × Setor
        </div>
        <div id="heatmap-toggle" style="display:flex;gap:3px;">
          <button data-mode="avg"   onclick="heatmapSetMode('avg')"   style="font-size:0.68rem;padding:0.2rem 0.6rem;border:none;border-radius:4px;cursor:pointer;background:#6366f1;color:#fff;font-weight:600;">Média</button>
          <button data-mode="total" onclick="heatmapSetMode('total')" style="font-size:0.68rem;padding:0.2rem 0.6rem;border:none;border-radius:4px;cursor:pointer;background:#f4f4f5;color:#52525b;font-weight:600;">Total</button>
        </div>
      </div>
      <div style="overflow-x:auto;">
        <table id="heatmap-matrix" style="width:100%;border-collapse:separate;border-spacing:3px;font-size:0.7rem;">
          <thead>
            <tr>
              <th style="text-align:left;padding:0.35rem 0.5rem;color:#71717a;font-weight:600;min-width:110px;"></th>
              <% matrix_sec_types.each do |st| %>
                <th style="text-align:center;padding:0.35rem 0.4rem;color:#71717a;font-weight:600;white-space:nowrap;">
                  <%= I18n.t("sector_types.#{st}", default: st.humanize) %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% matrix_ev_types.each do |et| %>
              <% ev_count = @events_by_type[et].to_i %>
              <tr>
                <td style="padding:0.3rem 0.5rem;color:#27272a;font-weight:500;white-space:nowrap;">
                  <%= I18n.t("event_types.#{et}", default: et.humanize) %>
                  <span style="font-size:0.6rem;color:#a1a1aa;font-weight:400;"> (<%= ev_count %> ev.)</span>
                </td>
                <% matrix_sec_types.each do |st| %>
                  <%
                    total     = @cost_matrix[et][st].to_f
                    avg       = ev_count > 0 ? total / ev_count : 0
                    avg_int   = matrix_avg_max   > 0 && avg   > 0 ? avg   / matrix_avg_max   : 0
                    total_int = matrix_total_max > 0 && total > 0 ? total / matrix_total_max : 0
                    avg_bg    = hm_bg.(avg_int);   total_bg  = hm_bg.(total_int)
                    avg_col   = hm_color.(avg_int, avg > 0); total_col = hm_color.(total_int, total > 0)
                    avg_label   = avg   > 0 ? number_to_currency(avg,   unit:"R$", separator:",", delimiter:".", precision:0) : "—"
                    total_label = total > 0 ? number_to_currency(total, unit:"R$", separator:",", delimiter:".", precision:0) : "—"
                  %>
                  <td data-avg="<%= avg_label %>"     data-avg-bg="<%= avg_bg %>"     data-avg-color="<%= avg_col %>"   data-avg-fw="<%= avg > 0 ? 600 : 400 %>"
                      data-total="<%= total_label %>" data-total-bg="<%= total_bg %>" data-total-color="<%= total_col %>" data-total-fw="<%= total > 0 ? 600 : 400 %>"
                      style="text-align:center;padding:0.3rem 0.5rem;border-radius:4px;background:<%= avg_bg %>;color:<%= avg_col %>;white-space:nowrap;min-width:80px;font-weight:<%= avg > 0 ? 600 : 400 %>;">
                    <%= avg_label %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div style="margin-top:0.7rem;font-size:0.65rem;color:#a1a1aa;display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
        <span>Intensidade:</span>
        <div style="display:flex;align-items:center;gap:2px;">
          <% [0.12, 0.34, 0.56, 0.78, 1.0].each do |op| %>
            <div style="width:14px;height:14px;border-radius:2px;background:rgba(99,102,241,<%= op %>);"></div>
          <% end %>
        </div>
        <span>menor → maior</span>
        <span style="margin-left:auto;">top <%= matrix_ev_types.size %> tipos ev. × top <%= matrix_sec_types.size %> tipos set.</span>
      </div>
    </div>
    <script>
      function heatmapSetMode(mode) {
        document.querySelectorAll('#heatmap-matrix td[data-avg]').forEach(function(td) {
          td.textContent       = mode === 'avg' ? td.dataset.avg      : td.dataset.total;
          td.style.background  = mode === 'avg' ? td.dataset.avgBg    : td.dataset.totalBg;
          td.style.color       = mode === 'avg' ? td.dataset.avgColor : td.dataset.totalColor;
          td.style.fontWeight  = mode === 'avg' ? td.dataset.avgFw    : td.dataset.totalFw;
        });
        document.querySelectorAll('#heatmap-toggle button').forEach(function(btn) {
          var active = btn.dataset.mode === mode;
          btn.style.background = active ? '#6366f1' : '#f4f4f5';
          btn.style.color      = active ? '#fff'    : '#52525b';
        });
      }
    </script>
  <% end %>

</div><%# /tab-financeiro %>

<%# ══════════════════════════════════════════════════════════════════════════
    PAINEL 3 — COLABORADORES
══════════════════════════════════════════════════════════════════════════ %>
<div id="tab-colaboradores" style="display:none;">

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.75rem;">
    <div class="metric-card" style="border-top:3px solid #f59e0b;">
      <div class="metric-label"><i class="bi bi-person-badge"></i> Cadastrados</div>
      <div class="metric-value metric-warn"><%= @total_users %></div>
      <div class="metric-sub">colaboradores no total</div>
    </div>
    <div class="metric-card" style="border-top:3px solid #0ea5e9;">
      <div class="metric-label"><i class="bi bi-people"></i> Média por evento</div>
      <div class="metric-value" style="color:#0369a1;"><%= @avg_members_per_event %></div>
      <div class="metric-sub">colaboradores / evento</div>
    </div>
  </div>

  <%# Ranking: colaboradores mais escalados %>
  <% if @top_collaborators.any? %>
    <div class="content-card" style="padding:1.1rem;margin-bottom:0.75rem;">
      <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;margin-bottom:0.85rem;">
        <i class="bi bi-trophy"></i> Colaboradores mais escalados
      </div>
      <div style="display:flex;flex-direction:column;gap:0.45rem;">
        <% @top_collaborators.each_with_index do |(user, count), idx| %>
          <div style="display:flex;align-items:center;gap:0.75rem;padding:0.5rem 0.65rem;border-radius:8px;background:<%= idx == 0 ? '#fefce8' : '#fafafa' %>;">
            <div style="width:22px;height:22px;border-radius:50%;background:<%= idx == 0 ? '#fbbf24' : idx == 1 ? '#d4d4d8' : idx == 2 ? '#d97706' : '#f4f4f5' %>;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <span style="font-size:0.62rem;font-weight:800;color:<%= idx < 3 ? '#fff' : '#71717a' %>;">#<%= idx + 1 %></span>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="font-size:0.8rem;font-weight:600;color:#18181b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= user&.name %></div>
            </div>
            <div style="font-size:0.78rem;font-weight:700;color:#4338ca;white-space:nowrap;">
              <%= count %> <span style="font-weight:400;color:#a1a1aa;font-size:0.68rem;">turno<%= count != 1 ? "s" : "" %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Gráfico: colaboradores por tipo de evento — top 10 %>
  <% if @collab_ref_by_event_type.any? %>
    <%
      collab_rows = @collab_ref_by_event_type.first(10)
      chart_max   = collab_rows.map { |_, s| s[:max] }.max.to_f
      min_width   = collab_rows.size * 72
    %>
    <div class="content-card" style="padding:1.1rem;">
      <div style="margin-bottom:1rem;">
        <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#a1a1aa;">
          <i class="bi bi-bar-chart-steps"></i> Colaboradores por tipo de evento — top 10
        </div>
        <div style="font-size:0.75rem;color:#71717a;margin-top:0.2rem;">
          Referência para planejar um novo evento. Barra escura = média · faixa clara = variação (mín → máx).
        </div>
      </div>

      <div style="overflow-x:auto;">
        <div style="display:flex;align-items:flex-end;gap:0.5rem;height:140px;min-width:<%= min_width %>px;">
          <% collab_rows.each do |ev_type, stats| %>
            <%
              avg_pct = chart_max > 0 ? (stats[:avg] / chart_max * 100).round(1) : 0
              max_pct = chart_max > 0 ? (stats[:max].to_f / chart_max * 100).round(1) : 0
            %>
            <div style="flex:1;min-width:62px;display:flex;flex-direction:column;align-items:center;height:100%;">
              <div style="font-size:0.62rem;font-weight:700;color:#4338ca;margin-bottom:4px;white-space:nowrap;">
                <%= number_with_precision(stats[:avg], precision: 1, separator: ",") %>
              </div>
              <div style="flex:1;width:100%;position:relative;">
                <div style="position:absolute;bottom:0;left:0;right:0;height:<%= max_pct %>%;background:#e0e7ff;border-radius:4px 4px 0 0;"></div>
                <div style="position:absolute;bottom:0;left:0;right:0;height:<%= avg_pct %>%;background:#6366f1;border-radius:4px 4px 0 0;z-index:2;"></div>
              </div>
            </div>
          <% end %>
        </div>
        <div style="display:flex;gap:0.5rem;border-top:1px solid #e4e4e7;padding-top:0.45rem;min-width:<%= min_width %>px;">
          <% collab_rows.each do |ev_type, stats| %>
            <div style="flex:1;min-width:62px;font-size:0.6rem;color:#71717a;text-align:center;line-height:1.35;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
              <%= I18n.t("event_types.#{ev_type}", default: ev_type.humanize) %>
              <span style="display:block;color:#a1a1aa;font-size:0.56rem;margin-top:1px;"><%= stats[:min] %>–<%= stats[:max] %> · <%= stats[:events] %> ev.</span>
            </div>
          <% end %>
        </div>
      </div>

      <div style="margin-top:0.85rem;padding-top:0.6rem;border-top:1px solid #f4f4f5;display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:0.4rem;font-size:0.68rem;color:#52525b;">
          <div style="width:20px;height:10px;background:#6366f1;border-radius:2px;"></div> Média
        </div>
        <div style="display:flex;align-items:center;gap:0.4rem;font-size:0.68rem;color:#52525b;">
          <div style="width:20px;height:10px;background:#e0e7ff;border-radius:2px;"></div> Variação (mín → máx)
        </div>
      </div>
    </div>
  <% end %>

</div><%# /tab-colaboradores %>

<%# ══════════════════════════════════════════════════════════════════════════
    PAINEL 4 — CALENDÁRIO
══════════════════════════════════════════════════════════════════════════ %>
<div id="tab-calendario" style="display:none;">

  <%# Dados dos eventos injetados como JSON -%>
  <script>
    var calendarEvents = <%= raw(@calendar_events.map { |e|
      { id: e.id,
        name: e.name,
        start: e.start_date.to_s,
        end:   e.end_date.to_s,
        status: e.status,
        url:   event_path(e),
        responsible: e.responsible_user&.name&.split&.first }
    }.to_json) %>;
  </script>

  <%# Estilos do calendário -%>
  <style>
    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 2px;
    }
    .cal-day-header {
      text-align: center;
      font-size: 0.72rem;
      font-weight: 700;
      color: #71717a;
      padding: 4px 0 6px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .cal-cell {
      min-height: 80px;
      background: #ffffff;
      border: 1px solid #f0f0f0;
      border-radius: 6px;
      padding: 4px 5px 5px;
      vertical-align: top;
      overflow: hidden;
    }
    .cal-cell.cal-empty {
      background: #fafafa;
    }
    .cal-cell.cal-today {
      border-color: #3b82f6;
      background: #eff6ff;
    }
    .cal-day-num {
      font-size: 0.78rem;
      font-weight: 600;
      color: #52525b;
      margin-bottom: 3px;
    }
    .cal-day-num.today-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      background: #3b82f6;
      color: #fff;
      border-radius: 50%;
      font-size: 0.73rem;
    }
    .cal-pill {
      display: block;
      font-size: 0.66rem;
      font-weight: 600;
      border-radius: 4px;
      padding: 2px 5px;
      margin-top: 2px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      text-decoration: none;
      max-width: 100%;
    }
    .cal-pill:hover { opacity: 0.8; }
    .cal-pill-draft  { background: #fef9c3; color: #854d0e; }
    .cal-pill-active { background: #dcfce7; color: #166534; }
    .cal-pill-closed { background: #f4f4f5; color: #52525b; }
  </style>

  <%# Cabeçalho do mês com navegação -%>
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
    <div style="display:flex;align-items:center;gap:0.5rem;">
      <button onclick="calNav(-1)" style="background:#f4f4f5;border:none;border-radius:6px;width:32px;height:32px;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;">‹</button>
      <h3 id="cal-header" style="margin:0;font-size:1rem;font-weight:700;min-width:180px;text-align:center;"></h3>
      <button onclick="calNav(+1)" style="background:#f4f4f5;border:none;border-radius:6px;width:32px;height:32px;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;">›</button>
    </div>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
      <span style="font-size:0.72rem;background:#dcfce7;color:#166534;font-weight:600;border-radius:4px;padding:2px 8px;"><i class="bi bi-circle-fill" style="font-size:0.5rem;margin-right:3px;"></i>Ativo</span>
      <span style="font-size:0.72rem;background:#fef9c3;color:#854d0e;font-weight:600;border-radius:4px;padding:2px 8px;"><i class="bi bi-circle-fill" style="font-size:0.5rem;margin-right:3px;"></i>Planejamento</span>
      <span style="font-size:0.72rem;background:#f4f4f5;color:#52525b;font-weight:600;border-radius:4px;padding:2px 8px;"><i class="bi bi-circle-fill" style="font-size:0.5rem;margin-right:3px;"></i>Encerrado</span>
    </div>
  </div>

  <%# Grade do calendário -%>
  <div class="content-card" style="padding:0.75rem;">
    <div class="cal-grid" id="cal-day-headers">
      <% %w[Dom Seg Ter Qua Qui Sex Sáb].each do |d| %>
        <div class="cal-day-header"><%= d %></div>
      <% end %>
    </div>
    <div class="cal-grid" id="cal-grid" style="margin-top:2px;"></div>
  </div>

  <script>
    var calYear  = new Date().getFullYear();
    var calMonth = new Date().getMonth(); // 0-based

    var PT_MONTHS = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho',
                     'Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

    function calPad(n) { return String(n).padStart(2, '0'); }

    function renderCalendar(year, month) {
      document.getElementById('cal-header').textContent = PT_MONTHS[month] + ' ' + year;

      var daysInMonth = new Date(year, month + 1, 0).getDate();
      var firstDow    = new Date(year, month, 1).getDay(); // 0=Sun

      var todayObj = new Date();
      var todayStr = todayObj.getFullYear() + '-' + calPad(todayObj.getMonth() + 1) + '-' + calPad(todayObj.getDate());

      // Filter events that overlap this month
      var mStart = year + '-' + calPad(month + 1) + '-01';
      var mEnd   = year + '-' + calPad(month + 1) + '-' + calPad(daysInMonth);

      var monthEvents = (calendarEvents || []).filter(function(ev) {
        return ev.start <= mEnd && ev.end >= mStart;
      });

      var grid = document.getElementById('cal-grid');
      var html = '';

      // Empty cells before the 1st
      for (var i = 0; i < firstDow; i++) {
        html += '<div class="cal-cell cal-empty"></div>';
      }

      for (var d = 1; d <= daysInMonth; d++) {
        var dateStr  = year + '-' + calPad(month + 1) + '-' + calPad(d);
        var isToday  = dateStr === todayStr;
        var dayEvents = monthEvents.filter(function(ev) {
          return ev.start <= dateStr && ev.end >= dateStr;
        });

        html += '<div class="cal-cell' + (isToday ? ' cal-today' : '') + '">';
        html += '<div class="cal-day-num' + (isToday ? ' today-num' : '') + '">' + d + '</div>';

        dayEvents.forEach(function(ev) {
          var cls = ev.status === 'active' ? 'cal-pill-active'
                  : ev.status === 'draft'  ? 'cal-pill-draft'
                  :                          'cal-pill-closed';
          // Escape strings to prevent XSS
          var safeName = ev.name.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
          var resp     = ev.responsible ? ev.responsible.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : null;
          var pillContent = '<span style="display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">' + safeName + '</span>';
          if (resp) pillContent += '<span style="display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-weight:400;font-size:0.62rem;margin-top:1px;"><i class="bi bi-person" style="font-size:0.6rem;"></i> ' + resp + '</span>';
          html += '<a href="' + ev.url + '" class="cal-pill ' + cls + '" style="white-space:normal;" title="' + safeName + (resp ? ' · ' + resp : '') + '">' + pillContent + '</a>';
        });

        html += '</div>';
      }

      grid.innerHTML = html;
    }

    function calNav(delta) {
      calMonth += delta;
      if (calMonth < 0)  { calMonth = 11; calYear--; }
      if (calMonth > 11) { calMonth = 0;  calYear++; }
      renderCalendar(calYear, calMonth);
    }

    // Renderiza imediatamente (script está no final do body, DOM já existe)
    renderCalendar(calYear, calMonth);
  </script>

</div><%# /tab-calendario %>

<%# ── Tab switcher JS ─────────────────────────────────────────────────────── %>
<script>
  function switchTab(name) {
    ['visao-geral', 'financeiro', 'colaboradores', 'calendario'].forEach(function(tab) {
      var panel = document.getElementById('tab-' + tab);
      var btn   = document.getElementById('tab-btn-' + tab);
      if (!panel || !btn) return;

      var isActive = tab === name;
      panel.style.display   = isActive ? '' : 'none';
      btn.style.border      = isActive ? '1px solid #e4e4e7' : '1px solid transparent';
      btn.style.borderBottom = isActive ? '1px solid #ffffff' : 'none';
      btn.style.background  = isActive ? '#ffffff' : 'transparent';
      btn.style.color       = isActive ? '#18181b' : '#71717a';
      btn.style.fontWeight  = isActive ? '600' : '400';
      btn.style.boxShadow   = isActive ? 'inset 0 2px 0 #18181b' : 'none';
      btn.style.zIndex      = isActive ? '1' : '0';
    });

    // Ao abrir o calendário, sempre reseta para o mês atual
    if (name === 'calendario' && typeof renderCalendar === 'function') {
      var now = new Date();
      calYear  = now.getFullYear();
      calMonth = now.getMonth();
      renderCalendar(calYear, calMonth);
    }

    // Persiste a aba ativa no sessionStorage
    try { sessionStorage.setItem('dash_tab', name); } catch(e) {}
  }

  // Restaura última aba ou abre Visão Geral
  (function() {
    var saved;
    try { saved = sessionStorage.getItem('dash_tab'); } catch(e) {}
    switchTab(saved && ['visao-geral','financeiro','colaboradores','calendario'].includes(saved) ? saved : 'visao-geral');
  })();
</script>
